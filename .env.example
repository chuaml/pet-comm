# ==============================================================================
# Pet Comm PWA — Cloudflare Pages Deployment Environment Template
# ==============================================================================
# Copy this file to `.env` (already git-ignored) and fill in your actual values.
# IMPORTANT: Never prefix secret tokens with `VITE_`, as Vite exposes `VITE_*`
# variables to client-side browser bundles.

# Cloudflare API Token with "Account -> Cloudflare Pages -> Edit" permission
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID (found on the right sidebar of your Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare Pages project name & production branch
CF_PAGES_PROJECT_NAME=pet-comm
CF_PAGES_PRODUCTION_BRANCH=main
